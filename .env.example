# Copy to .env and fill in. NEVER commit .env. NEVER paste these into a chat.

# --- Postgres (Neon) — state store ---
DATABASE_URL=postgresql://user:pass@host/db

# --- Descope MCP Server config URL (from Descope console → MCP Servers) ---
DESCOPE_CONFIG_URL=https://api.descope.com/v1/apps/agentic/P.../RS.../.well-known/openid-configuration

# --- Your gateway's public base URL (no /mcp suffix) ---
BASE_URL=https://your-tunnel.trycloudflare.com

# --- Your gateway's own identity - audience (RFC 8707, test compat) ---
RESOURCE_URL=https://your-tunnel.trycloudflare.com

# --- Legacy envs for test compatibility (auth.py + test_starter.py) ---
AUTH_ISSUER=https://auth.myapp.com
AUTH_JWKS_URL=https://auth.myapp.com/jwks.json

# --- Signs the short-lived session tokens (Concept 10) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_SECRET=change-me

# --- Run-it-live switch ---
# 1 = skip OAuth, use DEV_SUB. 0 = real Descope auth.
AUTH_DISABLED=0
DEV_SUB=dev-user-001

# --- Role for auth-disabled mode (admin/staff/customer) ---
# In real-auth mode, role comes from users.role column in DB.
DEV_ROLE=admin
